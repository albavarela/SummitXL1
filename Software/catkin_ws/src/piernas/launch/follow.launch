<launch>
  <arg name="scan_topic" default="/robot/front_laser/scan"/>
  <arg name="base_frame" default="robot_base_link"/>
  <arg name="tracking_frame" default="robot_odom"/>
  <arg name="cmd_vel_topic" default="/robot/cmd_vel"/>

  <!-- ========================================== -->
  <!-- PERCEPCIÓN 2D (Leg Detector)               -->
  <!-- ========================================== -->
  <node pkg="leg_detector" type="leg_detector" name="leg_detector" output="screen"
        args="scan:=$(arg scan_topic) $(find leg_detector)/config/trained_leg_detector.yaml">
    <param name="fixed_frame" value="$(arg tracking_frame)"/>
    <param name="publish_people" value="true"/>
    <param name="publish_people_markers" value="true"/>
  </node>
  
  <node pkg="piernas" type="Leg_detector.py" name="adaptador_leg" output="screen">
      <param name="people_topic" value="/datos_piernas_2d"/>
      <param name="target_frame" value="$(arg base_frame)"/>
      <param name="tracking_frame" value="$(arg tracking_frame)"/>
    </node>

  <!-- ========================================== -->
  <!-- MÁQUINA DE ESTADOS                   -->
  <!-- ========================================== -->
  <node pkg="piernas" type="state_machine.py" name="SummitXl" output="screen">
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
  </node>
</launch>